# ==============================================================================
# Zeonix eCards — Environment Configuration
# ==============================================================================
# Copy to `.env` for local development. On your hosting provider (Railway,
# Render, Fly.io, VPS...) set these in the provider's environment/dashboard —
# never commit real credentials to git.
#
# PRODUCTION CHECKLIST — variables marked [PROD REQUIRED] must be set on the
# production host. Frontend variables (VITE_*) are baked in at `npm run build`
# time; the defaults below are already production-correct.
# ==============================================================================

# ---- Email (inquiry notifications) ---- [PROD REQUIRED for email]
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=zeonix.business@example.com

# ---- Server ----
# Port the Node server listens on (hosts usually inject PORT automatically).
PORT=3001
# production | development (affects log verbosity, error detail, HSTS header)
NODE_ENV=production

# Persistent storage for inquiry submissions (JSON file database).
# Set to a mounted volume path in production so data survives redeploys,
# e.g. DATA_DIR=/data  (mount a volume/disk at /data).
# DATA_DIR=

# ---- CORS ----
# Only needed if you host the frontend on a DIFFERENT domain than the API.
# Comma-separated allowlist. Leave unset when frontend + API are served by
# this same server (recommended).
# CORS_ORIGINS=https://zeonixecards.com,https://www.zeonixecards.com

# ---- Reverse proxy ----
# Set to true ONLY when running behind a reverse proxy / PaaS ingress so the
# rate limiter trusts X-Forwarded-For (Railway, Render, Fly.io, nginx: true).
# TRUST_PROXY=true

# ---- Frontend (baked in at build time — defaults are production-correct) ----
# API endpoint used by the contact form. Default /api/contact works because
# the production server serves the site and the API on the same origin.
# VITE_CONTACT_API_URL=/api/contact

# WhatsApp number (international format, digits only, no "+") and default
# pre-filled message shown on every WhatsApp button.
# VITE_WHATSAPP_NUMBER=255699068552
# VITE_WHATSAPP_MESSAGE=Hello Zeonix eCards, I'm interested in getting a digital invitation. I would like to know more about your services.
